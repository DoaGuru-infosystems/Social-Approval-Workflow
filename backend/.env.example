# Server Configuration
PORT=5001
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=social_approval_db

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AES-256 Token Encryption Key (32-byte hex)
ENCRYPTION_KEY=7f4b39e2a18d45c602bf89ea1234567890abcdef1234567890abcdef12345678

# --- Meta (Instagram + Facebook) - ONE Agency App for all clients ---
META_APP_ID=DUMMY_REPLACE_LATER
META_APP_SECRET=DUMMY_REPLACE_LATER
META_REDIRECT_URI=http://localhost:5001/api/auth/meta/callback

# --- Google (YouTube) - ONE Agency App for all clients ---
GOOGLE_PROJECT_ID=socel-workflow
YOUTUBE_CLIENT_ID=DUMMY_REPLACE_LATER
YOUTUBE_CLIENT_SECRET=DUMMY_REPLACE_LATER
YOUTUBE_REDIRECT_URI=http://localhost:5001/api/auth/youtube/callback

# --- LinkedIn - ONE Agency App for all clients ---
LINKEDIN_CLIENT_ID=DUMMY_REPLACE_LATER
LINKEDIN_CLIENT_SECRET=DUMMY_REPLACE_LATER
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/auth/linkedin/callback

CLIENT_REDIRECT_URL=http://localhost:5173

# --- Already exists, DO NOT BREAK ---
GOOGLE_PLACES_API_KEY=DUMMY_REPLACE_LATER
